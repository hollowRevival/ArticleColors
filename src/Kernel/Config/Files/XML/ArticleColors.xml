<?xml version="1.0" encoding="utf-8" ?>
<otrs_config version="2.0" init="Application">
    <Setting Name="Loader::Module::AgentTicketZoom###001-ArticleColors" Required="0" Valid="1">
        <Description Translatable="1">Loads the ArticleColors stylesheet in AgentTicketZoom.</Description>
        <Navigation>Frontend::Agent::ModuleRegistration::Loader</Navigation>
        <Value>
            <Hash>
                <Item Key="CSS">
                    <Array>
                        <Item>ArticleColors.css</Item>
                    </Array>
                </Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="ArticleColors::ColorPreset" Required="1" Valid="1">
        <Description Translatable="1">Color preset for the article list in AgentTicketZoom. Used for all agents who have not picked their own preset in their personal preferences. The three color vision presets are designed for red-green, blue-yellow and total color blindness.</Description>
        <Navigation>Frontend::Agent::View::TicketZoom</Navigation>
        <Value>
            <Item ValueType="Select" SelectedID="Standard">
                <Item ValueType="Option" Value="Standard" Translatable="1">Standard (default colors)</Item>
                <Item ValueType="Option" Value="HighContrast" Translatable="1">High contrast (more saturated colors)</Item>
                <Item ValueType="Option" Value="Soft" Translatable="1">Soft (less saturated colors)</Item>
                <Item ValueType="Option" Value="Cool" Translatable="1">Cool (blue and purple instead of green and teal)</Item>
                <Item ValueType="Option" Value="RedGreenCVD" Translatable="1">Red-green color blindness (protanopia/deuteranopia)</Item>
                <Item ValueType="Option" Value="BlueYellowCVD" Translatable="1">Blue-yellow color blindness (tritanopia)</Item>
                <Item ValueType="Option" Value="Achromatopsia" Translatable="1">Total color blindness (patterns instead of colors)</Item>
            </Item>
        </Value>
    </Setting>
    <Setting Name="PreferencesGroups###ArticleColorsPreset" Required="0" Valid="1">
        <Description Translatable="1">Lets each agent pick their own article list color preset in the personal preferences, instead of always following ArticleColors::ColorPreset. The keys of the Data hash are also the presets the output filter accepts.</Description>
        <Navigation>Frontend::Agent::View::Preferences</Navigation>
        <Value>
            <Hash>
                <Item Key="Module">Kernel::Output::HTML::Preferences::Generic</Item>
                <Item Key="PreferenceGroup">Miscellaneous</Item>
                <Item Key="Label" Translatable="1">Article list colors</Item>
                <Item Key="Desc" Translatable="1">Choose your own color preset for the article list in the ticket view, or follow the system default.</Item>
                <Item Key="Key"></Item>
                <Item Key="Data">
                    <Hash>
                        <Item Key="UseGlobalDefault" Translatable="1">Use the system default</Item>
                        <Item Key="Standard" Translatable="1">Standard (default colors)</Item>
                        <Item Key="HighContrast" Translatable="1">High contrast (more saturated colors)</Item>
                        <Item Key="Soft" Translatable="1">Soft (less saturated colors)</Item>
                        <Item Key="Cool" Translatable="1">Cool (blue and purple instead of green and teal)</Item>
                        <Item Key="RedGreenCVD" Translatable="1">Red-green color blindness (protanopia/deuteranopia)</Item>
                        <Item Key="BlueYellowCVD" Translatable="1">Blue-yellow color blindness (tritanopia)</Item>
                        <Item Key="Achromatopsia" Translatable="1">Total color blindness (patterns instead of colors)</Item>
                    </Hash>
                </Item>
                <Item Key="DataSelected">UseGlobalDefault</Item>
                <Item Key="PrefKey">UserArticleColorsPreset</Item>
                <Item Key="Prio">8100</Item>
                <Item Key="Active">1</Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="Frontend::Output::FilterElementPost###ArticleColors" Required="0" Valid="1">
        <Description Translatable="1">Adds the color preset and channel classes that the ArticleColors stylesheet uses to the article list of AgentTicketZoom.</Description>
        <Navigation>Frontend::Base::OutputFilter</Navigation>
        <Value>
            <Hash>
                <Item Key="Module">Kernel::Output::HTML::OutputFilter::ArticleColors</Item>
                <Item Key="Templates">
                    <Hash>
                        <Item Key="AgentTicketZoom">1</Item>
                    </Hash>
                </Item>
            </Hash>
        </Value>
    </Setting>
</otrs_config>
